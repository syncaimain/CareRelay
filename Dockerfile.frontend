FROM node:22-slim
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json next-env.d.ts next.config.ts postcss.config.mjs components.json ./
COPY app app
COPY components components
COPY lib lib
RUN npm run build
CMD ["npx", "next", "start", "--hostname", "0.0.0.0", "--port", "3104"]
